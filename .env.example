# Copy to .env on the Linux server. Compose loads it; ordinary Django commands do not.
# Replace this example with an IPv4 address actually assigned to your Linux server.
# Check with: ip -4 addr show
LAN_IP=192.168.2.57
BUDGET_HOST=budget.home
# Host ports; Caddy still listens on 80/443 inside its container.
HTTP_PORT=9080
HTTPS_PORT=9443
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=
